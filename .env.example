# SHA Interface Interiors - Configuration & Environment Variables
# Copy this file to .env and configure your local settings.

# Google Gemini API Key (Optional: for AI Assistant natural language queries)
# If not configured, the CRM operates with full functionality using the built-in deterministic intelligence engine.
GEMINI_API_KEY=your_gemini_api_key_here

# n8n Workflow Automation (Optional: for webhook dispatching)
# Example: http://localhost:5678 or https://n8n.yourdomain.com
N8N_BASE_URL=
N8N_API_KEY=

# Studio Business Defaults
STUDIO_TIMEZONE=Asia/Kolkata
STUDIO_PRIMARY_CITIES=Bangalore,Hyderabad
STUDIO_MINIMUM_TARGET_BUDGET="₹5 lakh–₹10 lakh"
